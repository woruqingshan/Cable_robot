Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 40; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Alpha: 0.3
    - Class: rviz_default_plugins/RobotModel
      Name: JetRover Official Model
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /idc_replay/robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
      Links:
        All Links Enabled: true
    - Class: rviz_default_plugins/TF
      Name: Private Replay TF
      Enabled: true
      Show Names: false
      Show Axes: false
      Show Arrows: false
      Marker Scale: 0.08
    - Class: rviz_default_plugins/MarkerArray
      Name: IDC Scene (38 saved collision objects)
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /idc_replay/scene_markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
    - Class: rviz_default_plugins/MarkerArray
      Name: Ports and Saved TCP
      Enabled: true
      Namespaces: {}
      Topic:
        Value: /idc_replay/port_markers
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.35
      Pitch: 0.48
      Yaw: 0.9
      Focal Point:
        X: 0.24
        Y: 0
        Z: 0.16
      Target Frame: base_link
Window Geometry:
  Width: 1250
  Height: 850
