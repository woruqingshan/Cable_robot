<robot name="jetrover">
  <group name="arm">
    <joint name="joint1" />
    <joint name="joint2" />
    <joint name="joint3" />
    <joint name="joint4" />
    <joint name="joint5" />
  </group>
  <group name="gripper">
    <joint name="r_joint" />
  </group>
  <disable_collisions link1="back_shell_black_link" link2="back_shell_green_link" reason="ReviewedFixedAssembly_ModelOnly" />
  <disable_collisions link1="back_shell_green_link" link2="base_link" reason="ReviewedFixedAssembly_ModelOnly" />
  <disable_collisions link1="gripper_link" link2="link5" reason="ReviewedFixedAssembly_ModelOnly" />
  <disable_collisions link1="link1" link2="servo_link1" reason="ReviewedFixedAssembly_ModelOnly" />
  <disable_collisions link1="link4" link2="servo_link2" reason="ReviewedFixedAssembly_ModelOnly" />
</robot>
