Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 35; 40; 48
    Fixed Frame: base_link
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Reference Grid (not a collision model)
      Enabled: true
      Plane: XY
      Cell Size: 0.1
      Plane Cell Count: 20
      Alpha: 0.3
    - Class: rviz_default_plugins/RobotModel
      Name: External JetRover URDF — Read Only
      Enabled: true
      Alpha: 1
      Description Source: Topic
      Description Topic:
        Value: /idc_vla/preview/robot_description
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Visual Enabled: true
      Collision Enabled: false
    - Class: rviz_default_plugins/MarkerArray
      Name: Validation Label and EE Waypoints
      Enabled: true
      Topic:
        Value: /idc_vla/preview/markers
        Depth: 10
        Reliability Policy: Reliable
        Durability Policy: Volatile
    - Class: rviz_default_plugins/TF
      Name: Private Preview TF
      Enabled: true
      Show Names: false
      Show Axes: false
      Show Arrows: false
      Marker Scale: 0.08
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Pitch: 0.45
      Yaw: 0.85
      Focal Point:
        X: 0.12
        Y: 0
        Z: 0.2
      Target Frame: base_link
Window Geometry:
  Width: 1250
  Height: 850
